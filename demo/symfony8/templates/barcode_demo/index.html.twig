{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Barcode FormType demos',
        intro: 'Each example uses a different configuration (scanner, formats, max length, help text).',
    }) }}
{% endblock %}

{% block body %}
    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            <table class="nowo-ui-data-table">
                <tbody>
                    {% for slug, cfg in examples %}
                        <tr>
                            <td>
                                <a class="nowo-ui-link" href="{{ path('app_demo_barcode', { slug: slug }) }}">{{ cfg.title }}</a>
                                <div class="nowo-ui-muted">{{ cfg.help }}</div>
                            </td>
                            <td><span class="nowo-ui-badge nowo-ui-badge--neutral">{{ slug }}</span></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
