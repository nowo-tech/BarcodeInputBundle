{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: demo_title,
        intro: 'Single text field with optional camera scanner.',
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Barcode field', kind: 'form', testid: 'demo-case', form: form} %}
        {% block section_body %}
            {{ form_start(form, {attr: {id: 'barcode-demo-form', class: 'nowo-ui-form'}}) }}
                {{ form_widget(form) }}
            {{ form_end(form) }}
        {% endblock %}
        {% block section_footer %}
            <button type="submit" form="barcode-demo-form" class="nowo-ui-btn nowo-ui-btn--primary">Submit barcode</button>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    <script src="{{ asset('barcode-input.js', 'nowo_barcode_input') }}"></script>
{% endblock %}
