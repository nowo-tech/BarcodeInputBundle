{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: demo_title,
        intro: 'Single text field with optional camera scanner.',
    }) }}
{% endblock %}

{% block body %}
    {% if barcode_value is not null %}
        <div class="nowo-ui-flash nowo-ui-flash--success" role="alert">
            Submitted barcode value: <code class="nowo-ui-code">{{ barcode_value }}</code>
        </div>
    {% endif %}

    {% set _items = [{ label: 'All demos', href: path('app_demo_index') }] %}
    {% for slug, cfg in examples %}
        {% set _items = _items|merge([{ label: cfg.title, href: path('app_demo_barcode', { slug: slug }), current: slug == demo_slug }]) %}
    {% endfor %}
    {{ include(nowo_ui_partial('tabs'), { items: _items, aria_label: 'Barcode examples' }) }}

    <section class="nowo-ui-card" data-testid="demo-case">
        <div class="nowo-ui-card__body">
            {{ form_start(form) }}
                {% for child in form %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(form) }}
        </div>
    </section>

    <script src="{{ asset('barcode-input.js', 'nowo_barcode_input') }}"></script>
{% endblock %}
