parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - demo/*
    bootstrapFiles:
        - vendor/autoload.php
    reportUnmatchedIgnoredErrors: false

includes:
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
  # worker-strict includes worker rules and also flags request-superglobal access
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker-strict.neon
